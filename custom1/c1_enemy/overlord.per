; leader: default target is your nearest building
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 202 ov-phase)
    (up-get-point ov-pos-self ov-home-x)
    (up-get-point ov-pos-target ov-tgt-x)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-home-x c:< 0)
=>
    (up-get-point ov-pos-center ov-home-x)
)

; no target yet (for example during the truce): use your start position
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tgt-x c:< 0)
=>
    (up-get-point ov-pos-focus ov-tgt-x)
)

; leader: a recent king sighting overrides that
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-ktime c:> 0)
=>
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-ktime)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-ktime c:> 0)
    (up-compare-goal ov-tmp c:<= ov-king-memory)
=>
    (up-get-shared-goal c: 240 ov-tgt-x)
    (up-get-shared-goal c: 241 ov-tgt-y)
)

; leader: rally point sits ov-rally-dist tiles in front of the target, toward the leader's base
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-tgt-y c:>= 0)
=>
    (up-set-shared-goal c: 206 g: ov-tgt-x)
    (up-set-shared-goal c: 207 g: ov-tgt-y)
    (up-modify-goal ov-rally-x g:= ov-tgt-x)
    (up-modify-goal ov-rally-y g:= ov-tgt-y)
    (up-lerp-tiles ov-rally-x ov-home-x c: ov-rally-dist)
    (up-bound-point ov-rally-x ov-rally-x)
    (up-get-shared-goal c: 204 ov-home-x)
    (up-get-shared-goal c: 205 ov-home-y)
    (up-get-point-distance ov-rally-x ov-home-x ov-dist)
)

; ...but only move it when it shifts noticeably, so marching armies aren't re-ordered for nothing
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tgt-x c:>= 0)
    (or (up-compare-goal ov-home-x c:<= 0) (up-compare-goal ov-dist c:> ov-rally-move))
=>
    (up-set-shared-goal c: 204 g: ov-rally-x)
    (up-set-shared-goal c: 205 g: ov-rally-y)
)

; leader: start the first gather (right away, or near the end of the truce)
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 0)
    (up-compare-goal ov-treaty c:<= ov-stage-secs)
=>
    (up-set-shared-goal c: 202 c: 1)
    (up-set-shared-goal c: 208 g: ov-now)
    (up-modify-goal ov-phase c:= 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-treaty c:> 0)
    (up-compare-const ov-chatty == 1)
=>
    (up-chat-data-to-all "c1_enemy coalition: gathering, truce ends in %d seconds" g: ov-treaty)
    (disable-self)
)

; leader: ov-tmp = seconds in phase, ov-tmp2 = ready x 100, ov-needed = alive x pct
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 208 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
    (up-modify-goal ov-tmp2 g:= ov-ready)
    (up-modify-goal ov-tmp2 c:* 100)
    (up-modify-goal ov-needed g:= ov-alive)
    (up-modify-goal ov-needed c:* ov-team-ready-pct)
)

; leader: gather -> attack when most armies are ready (or the gather timer ran out) and the truce is over
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-treaty c:<= 0)
    (up-compare-goal ov-armysum c:>= ov-min-team-army)
    (up-compare-goal ov-ready c:>= 1)
    (or (up-compare-goal ov-tmp2 g:>= ov-needed) (up-compare-goal ov-tmp c:>= ov-gather-timeout))
=>
    (up-set-shared-goal c: 202 c: 2)
    (up-set-shared-goal c: 208 g: ov-now)
    (up-set-shared-goal c: 209 g: ov-armysum)
    (up-get-shared-goal c: 203 ov-wave)
    (up-modify-goal ov-wave c:+ 1)
    (up-set-shared-goal c: 203 g: ov-wave)
    (up-modify-goal ov-phase c:= 2)
    (up-modify-goal ov-tmp c:= 0)
    (up-chat-data-to-all "c1_enemy coalition: ATTACK! wave %d" g: ov-wave)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 209 ov-armystart)
    (up-modify-goal ov-tmp2 g:= ov-armysum)
    (up-modify-goal ov-tmp2 c:* 100)
    (up-modify-goal ov-needed g:= ov-armystart)
    (up-modify-goal ov-needed c:* ov-retreat-pct)
)

; leader: attack -> regroup after heavy losses or a long fight
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (or (up-compare-goal ov-tmp2 g:< ov-needed) (up-compare-goal ov-tmp c:>= ov-attack-timeout))
=>
    (up-set-shared-goal c: 202 c: 1)
    (up-set-shared-goal c: 208 g: ov-now)
    (up-modify-goal ov-phase c:= 1)
    (up-chat-data-to-all "c1_enemy coalition: regrouping, %d soldiers left" g: ov-armysum)
)

; every AI: read the shared plan
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 202 ov-phase)
    (up-get-shared-goal c: 204 ov-rally-x)
    (up-get-shared-goal c: 205 ov-rally-y)
    (up-get-shared-goal c: 206 ov-tgt-x)
    (up-get-shared-goal c: 207 ov-tgt-y)
)

; phase changed: reset my ready flag and pulse count
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase g:!= ov-last-phase)
=>
    (up-modify-goal ov-pulses c:= 0)
    (up-modify-goal ov-regroup-first c:= 0)
    (up-modify-goal ov-idx c:= 220)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx c: 0)
)

; coming back from an attack: pull everyone out on this tick
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-last-phase c:== 2)
=>
    (up-modify-goal ov-regroup-first c:= 1)
    (up-modify-goal ov-slow c:= 0)
)

; attack just started: launch the whole army on this tick
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (up-compare-goal ov-last-phase c:!= 2)
=>
    (up-modify-goal ov-launch c:= 1)
    (up-modify-goal ov-reinforce c:= 1)
    (up-modify-goal ov-sent-x g:= ov-tgt-x)
    (up-modify-goal ov-sent-y g:= ov-tgt-y)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-modify-goal ov-last-phase g:= ov-phase)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (up-compare-goal ov-launch c:== 0)
=>
    (up-get-point-distance ov-tgt-x ov-sent-x ov-dist)
    (up-modify-goal ov-reinforce c:+ 1)
)

; the target (your king) moved: re-launch at the new spot
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (up-compare-goal ov-launch c:== 0)
    (up-compare-goal ov-dist c:> ov-retarget-dist)
=>
    (up-modify-goal ov-launch c:= 1)
    (up-modify-goal ov-sent-x g:= ov-tgt-x)
    (up-modify-goal ov-sent-y g:= ov-tgt-y)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-reinforce c:> ov-reinforce-every)
=>
    (up-modify-goal ov-reinforce c:= 0)
)

; coalition running: no stock attack groups, town-spreading or far defend-assists
(defrule
    (up-compare-goal ov-phase c:>= 1)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-disable-attack-groups 1)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-disable-defend-groups ov-defend-flags)
    (set-strategic-number sn-number-tasked-units 0)
    (set-strategic-number sn-enable-patrol-attack 1)
)

; at the pop cap, idle trade carts give their population to soldiers
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:== 0)
    (population-headroom < ov-cart-headroom)
    (up-idle-unit-count ov-idle-trade-cart >= 1)
=>
    (up-delete-idle-units ov-idle-trade-cart)
)

;;; ---------- GATHER: everyone marches to the rally point
; count my soldiers at the rally point
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-slow c:== 0)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: -1 c: ov-near-dist)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-modify-goal ov-needed g:= ov-army)
    (up-modify-goal ov-needed c:* ov-ready-pct)
    (up-modify-goal ov-needed c:/ 100)
    (up-modify-goal ov-needed c:min ov-ready-cap)
)

; enough of my army is assembled: report ready
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-army c:>= ov-min-army)
    (up-compare-goal ov-ss g:>= ov-needed)
    (up-compare-goal ov-pulses c:>= 1)
=>
    (up-modify-goal ov-idx c:= 220)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx c: 1)
)

; regroup: everyone falls back, plain move, even mid-fight
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 1)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-near-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-target-point ov-rally-x ov-act-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 1)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-near-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-target-point ov-rally-x ov-act-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 1)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-near-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-target-point ov-rally-x ov-act-move ov-march-formation ov-stance-aggressive)
)

; march pulse: every soldier not fighting and not there yet
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 0)
    (up-compare-goal ov-slow c:== 0)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-arrived-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-action == ov-actionid-attack)
    (up-target-point ov-rally-x ov-act-attack-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 0)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-arrived-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-action == ov-actionid-attack)
    (up-target-point ov-rally-x ov-act-attack-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 0)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-arrived-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-action == ov-actionid-attack)
    (up-target-point ov-rally-x ov-act-attack-move ov-march-formation ov-stance-aggressive)
)

; between pulses: idle soldiers away from the rally get moving again
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 0)
    (up-compare-goal ov-slow c:!= 0)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-near-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-idling == 0)
    (up-target-point ov-rally-x ov-act-attack-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 0)
    (up-compare-goal ov-slow c:!= 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-near-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-idling == 0)
    (up-target-point ov-rally-x ov-act-attack-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 0)
    (up-compare-goal ov-slow c:!= 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-rally-x)
    (up-filter-distance c: ov-near-dist c: -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-idling == 0)
    (up-target-point ov-rally-x ov-act-attack-move ov-march-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-slow c:== 0)
=>
    (up-modify-goal ov-pulses c:+ 1)
    (up-modify-goal ov-regroup-first c:= 0)
)

;;; ---------- ATTACK: launch, reinforce in groups, keep idle soldiers moving
; launch: the whole army near the target goes in as one formation
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (up-compare-goal ov-tgt-x c:> 0)
    (up-compare-goal ov-launch c:== 1)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-set-target-point ov-tgt-x)
    (up-filter-distance c: -1 c: ov-launch-radius)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-action == ov-actionid-attack)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (up-compare-goal ov-tgt-x c:> 0)
    (up-compare-goal ov-launch c:== 1)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-set-target-point ov-tgt-x)
    (up-filter-distance c: -1 c: ov-launch-radius)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-action == ov-actionid-attack)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (up-compare-goal ov-tgt-x c:> 0)
    (up-compare-goal ov-launch c:== 1)
    (up-compare-goal ov-ss-last c:>= 240)
=>
