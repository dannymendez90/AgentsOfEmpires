(defconst ov-ss 432)
(defconst ov-ss-last 433)
(defconst ov-ss-remote 434)
(defconst ov-ss-remote-last 435)
(defconst ov-rally-x 436)
(defconst ov-rally-y 437)
(defconst ov-tgt-x 438)
(defconst ov-tgt-y 439)
(defconst ov-home-x 440)
(defconst ov-home-y 441)
(defconst ov-lead-num 442)
(defconst ov-lead-time 443)
(defconst ov-launch 444)
(defconst ov-spytime 445)

; always attack the overlord
(defrule
    (true)
=>
    (set-strategic-number sn-target-player-number ov-target-player)
    (set-strategic-number sn-focus-player-number ov-target-player)
)

(defrule
    (player-number 1)
=>
    (up-modify-goal ov-me c:= 1)
    (disable-self)
)

(defrule
    (player-number 2)
=>
    (up-modify-goal ov-me c:= 2)
    (disable-self)
)

(defrule
    (player-number 3)
=>
    (up-modify-goal ov-me c:= 3)
    (disable-self)
)

(defrule
    (player-number 4)
=>
    (up-modify-goal ov-me c:= 4)
    (disable-self)
)

(defrule
    (player-number 5)
=>
    (up-modify-goal ov-me c:= 5)
    (disable-self)
)

(defrule
    (player-number 6)
=>
    (up-modify-goal ov-me c:= 6)
    (disable-self)
)

(defrule
    (player-number 7)
=>
    (up-modify-goal ov-me c:= 7)
    (disable-self)
)

(defrule
    (player-number 8)
=>
    (up-modify-goal ov-me c:= 8)
    (disable-self)
)

; clock
(defrule
    (true)
=>
    (up-get-fact ov-fact-game-time 0 ov-now)
    (up-modify-goal ov-tick c:= 0)
)

(defrule
    (up-compare-goal ov-now g:>= ov-next-tick)
=>
    (up-modify-goal ov-tick c:= 1)
    (up-modify-goal ov-next-tick g:= ov-now)
    (up-modify-goal ov-next-tick c:+ ov-tick-secs)
    (up-modify-goal ov-slow c:+ 1)
    (up-get-treaty-data ov-treaty)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:>= ov-cmd-every)
=>
    (up-modify-goal ov-slow c:= 0)
)

(defrule
    (up-compare-goal ov-me c:>= 1)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (up-chat-data-to-all "c1_enemy: player %d joined the coalition" g: ov-me)
    (disable-self)
)

; heartbeat and army size for the leader
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-fact ov-fact-military-pop 0 ov-army)
    (up-modify-goal ov-idx c:= 210)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx g: ov-now)
    (up-modify-goal ov-idx c:= 230)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx g: ov-army)
)

; every AI: report your king whenever it can see him
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-find-remote c: ov-king-class c: 1)
    (up-get-search-state ov-ss)
)

(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
=>
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-ktime)
)

; leader: announce a fresh sighting so you can tell Treason worked
(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:> ov-king-stale)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy coalition: king spotted, attacking his position")
)

(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
=>
    (up-modify-goal ov-ktime g:= ov-now)
    (up-set-target-object ov-search-remote c: 0)
    (up-get-object-data ov-od-px ov-tmp)
    (up-get-object-data ov-od-py ov-tmp2)
    (up-set-shared-goal c: 240 g: ov-tmp)
    (up-set-shared-goal c: 241 g: ov-tmp2)
    (up-set-shared-goal c: 242 g: ov-now)
)

; Treason rota without shared state: each 10-minute slot belongs to one AI (P2, P3, ... P8, repeat). ov-tmp = seconds into my slot (0 to ov-spy-every-1 when it's my turn)
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 242 ov-ktime)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp c:mod ov-spy-cycle)
    (up-modify-goal ov-tmp2 g:= ov-me)
    (up-modify-goal ov-tmp2 c:- 2)
    (up-modify-goal ov-tmp2 c:* ov-spy-every)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

; Regicide: my slot and I haven't used Treason in it yet
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:>= 1)
    (up-compare-goal ov-tmp c:>= 0)
    (up-compare-goal ov-tmp c:< ov-spy-every)
    (up-compare-goal ov-spytime c:== 0)
    (can-spy)
=>
    (spy)
    (up-modify-goal ov-spytime c:= 1)
)

; outside my slot: ready for my next one
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-tmp c:>= ov-spy-every)
=>
    (up-modify-goal ov-spytime c:= 0)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-tmp c:< 0)
=>
    (up-modify-goal ov-spytime c:= 0)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-spytime c:== 1)
    (up-compare-const ov-chatty == 1)
=>
    (up-chat-data-to-all "c1_enemy: player %d used Treason to find your king" g: ov-me)
    (up-modify-goal ov-spytime c:= 2)
)

; other game modes only: Spies once (in Regicide this tech is Treason, handled above)
(defrule
    (not (regicide-game))
    (up-compare-goal ov-phase c:>= 1)
    (can-research ov-ri-spies)
=>
    (research ov-ri-spies)
    (disable-self)
)

; leader election: first AI to find no living leader takes over
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 200 ov-lead-num)
    (up-get-shared-goal c: 201 ov-lead-time)
    (up-modify-goal ov-leader c:= 0)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-lead-time)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-lead-num g:== ov-me)
=>
    (up-modify-goal ov-leader c:= 1)
    (up-set-shared-goal c: 201 g: ov-now)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 0)
    (or (up-compare-goal ov-lead-num c:== 0) (up-compare-goal ov-tmp c:> ov-hb-stale))
=>
    (up-set-shared-goal c: 200 g: ov-me)
    (up-set-shared-goal c: 201 g: ov-now)
    (up-modify-goal ov-leader c:= 1)
)

; leader: count living, ready and total army across the team
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-modify-goal ov-alive c:= 0)
    (up-modify-goal ov-ready c:= 0)
    (up-modify-goal ov-armysum c:= 0)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 211 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 231 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 221 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 212 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

