;;; overlord.per - generated by custom1/gen_overlord.py; edit that file, not this one.
;;; Team coordination layer (v7) for c1_enemy on top of the stock Promisory AI.

(defconst ov-target-player 1)
(defconst ov-truce-max 1800)
(defconst ov-tick-secs 5)
(defconst ov-wave-every 180)
(defconst ov-idle-every 6)
(defconst ov-home-radius 30)
(defconst ov-retarget-dist 12)
(defconst ov-king-memory 1200)
(defconst ov-attack-formation 4)
(defconst ov-spy-every 900)
(defconst ov-spy-lead 30)
(defconst ov-spy-gold 1000)
(defconst ov-spy-check 20)
(defconst ov-report-all 200)
(defconst ov-defend-flags 14)
(defconst ov-cart-headroom 15)
(defconst ov-chatty 1)
(defconst ov-plenty 3000)
(defconst ov-camp-dist 12)
(defconst ov-first-spy 1770)
(defconst ov-fact-game-time 0)
(defconst ov-fact-military-pop 31)
(defconst ov-pos-self 9)
(defconst ov-pos-target 10)
(defconst ov-pos-focus 11)
(defconst ov-search-local 1)
(defconst ov-search-remote 2)
(defconst ov-act-attack-move 19)
(defconst ov-stance-aggressive 0)
(defconst ov-cmdid-military 4)
(defconst ov-all-units -1)
(defconst ov-od-class 2)
(defconst ov-od-px 8)
(defconst ov-od-py 9)
(defconst ov-od-garrisoned 17)
(defconst ov-od-distance 44)
(defconst ov-od-idling 49)
(defconst ov-king-class 959)
(defconst ov-king-unit 434)
(defconst ov-transport-class 920)
(defconst ov-fishing-class 921)
(defconst ov-warship-class 922)
(defconst ov-unpacked-treb-class 954)
(defconst ov-idle-trade-cart 1)
(defconst ov-ri-spies 408)
(defconst ov-castle 82)
(defconst ov-now 402)
(defconst ov-me 403)
(defconst ov-next-tick 404)
(defconst ov-tick 405)
(defconst ov-slow 406)
(defconst ov-tmp 408)
(defconst ov-tmp2 409)
(defconst ov-ordid 410)
(defconst ov-myord 411)
(defconst ov-spied 412)
(defconst ov-army 413)
(defconst ov-dist 424)
(defconst ov-ktime 426)
(defconst ov-ss 432)
(defconst ov-ss-last 433)
(defconst ov-ss-remote 434)
(defconst ov-ss-remote-last 435)
(defconst ov-kx 436)
(defconst ov-ky 437)
(defconst ov-tgt-x 438)
(defconst ov-tgt-y 439)
(defconst ov-home-x 440)
(defconst ov-home-y 441)
(defconst ov-spytime 445)

; always attack the overlord
(defrule
    (true)
=>
    (set-strategic-number sn-target-player-number ov-target-player)
    (set-strategic-number sn-focus-player-number ov-target-player)
)

(defrule
    (player-number 1)
=>
    (up-modify-goal ov-me c:= 1)
    (disable-self)
)

(defrule
    (player-number 2)
=>
    (up-modify-goal ov-me c:= 2)
    (disable-self)
)

(defrule
    (player-number 3)
=>
    (up-modify-goal ov-me c:= 3)
    (disable-self)
)

(defrule
    (player-number 4)
=>
    (up-modify-goal ov-me c:= 4)
    (disable-self)
)

(defrule
    (player-number 5)
=>
    (up-modify-goal ov-me c:= 5)
    (disable-self)
)

(defrule
    (player-number 6)
=>
    (up-modify-goal ov-me c:= 6)
    (disable-self)
)

(defrule
    (player-number 7)
=>
    (up-modify-goal ov-me c:= 7)
    (disable-self)
)

(defrule
    (player-number 8)
=>
    (up-modify-goal ov-me c:= 8)
    (disable-self)
)

; clock
(defrule
    (true)
=>
    (up-get-fact ov-fact-game-time 0 ov-now)
    (up-modify-goal ov-tick c:= 0)
)

(defrule
    (up-compare-goal ov-now g:>= ov-next-tick)
=>
    (up-modify-goal ov-tick c:= 1)
    (up-modify-goal ov-next-tick g:= ov-now)
    (up-modify-goal ov-next-tick c:+ ov-tick-secs)
    (up-modify-goal ov-slow c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:>= ov-idle-every)
=>
    (up-modify-goal ov-slow c:= 0)
)

; proof the coalition layer is running
(defrule
    (player-number 2)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 2 joined the coalition (v7)")
    (disable-self)
)

(defrule
    (player-number 3)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 3 joined the coalition (v7)")
    (disable-self)
)

(defrule
    (player-number 4)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 4 joined the coalition (v7)")
    (disable-self)
)

(defrule
    (player-number 5)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 5 joined the coalition (v7)")
    (disable-self)
)

(defrule
    (player-number 6)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 6 joined the coalition (v7)")
    (disable-self)
)

(defrule
    (player-number 7)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 7 joined the coalition (v7)")
    (disable-self)
)

(defrule
    (player-number 8)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 8 joined the coalition (v7)")
    (disable-self)
)

; every AI: look for your king (by unit type first)
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number ov-target-player)
    (up-full-reset-search)
    (up-find-remote c: ov-king-unit c: 1)
    (up-get-search-state ov-ss)
)

; ...then by class
(defrule
    (up-compare-goal ov-ss-remote c:< 1)
=>
    (up-find-remote c: ov-king-class c: 1)
    (up-get-search-state ov-ss)
)

; I can see him: share his position
(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
=>
    (up-set-target-object ov-search-remote c: 0)
    (up-get-object-data ov-od-px ov-kx)
    (up-get-object-data ov-od-py ov-ky)
    (up-modify-goal ov-ktime g:= ov-now)
    (up-set-shared-goal c: 240 g: ov-kx)
    (up-set-shared-goal c: 241 g: ov-ky)
    (up-set-shared-goal c: 242 g: ov-now)
    (up-get-shared-goal c: 206 ov-tgt-x)
    (up-get-shared-goal c: 207 ov-tgt-y)
    (up-modify-goal ov-dist c:= 9999)
)

(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
    (up-compare-goal ov-tgt-x c:> 0)
=>
    (up-get-point-distance ov-kx ov-tgt-x ov-dist)
)

; after the truce, a sighting away from the current target: he's the target now, everyone goes
(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-dist c:> ov-retarget-dist)
=>
    (up-set-shared-goal c: 206 g: ov-kx)
    (up-set-shared-goal c: 207 g: ov-ky)
    (up-get-shared-goal c: 245 ov-tmp)
    (up-modify-goal ov-tmp c:+ 1)
    (up-set-shared-goal c: 245 g: ov-tmp)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp c:+ ov-wave-every)
    (up-set-shared-goal c: 246 g: ov-tmp)
    (up-chat-data-to-all "c1_enemy: player %d sees your king - ALL armies attack him" g: ov-me)
)

; Treason: one team clock (SPYNEXT); first one ov-spy-lead seconds before the truce ends
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 243 ov-spytime)
    (up-get-shared-goal c: 242 ov-ktime)
    (up-modify-goal ov-spytime c:max ov-first-spy)
)

; Treason due and I have a castle: make sure the gold is there (the queen's pad can drain it)
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now g:>= ov-spytime)
    (building-type-count ov-castle >= 1)
    (gold-amount < ov-spy-gold)
=>
    (cc-add-resource gold ov-spy-gold)
)

; Treason = castle tech 408. The team clock stops the others until the next one
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now g:>= ov-spytime)
    (building-type-count ov-castle >= 1)
    (can-research ov-ri-spies)
=>
    (research ov-ri-spies)
    (up-modify-goal ov-spied g:= ov-now)
    (up-modify-goal ov-spytime g:= ov-now)
    (up-modify-goal ov-spytime c:+ ov-spy-every)
    (up-set-shared-goal c: 243 g: ov-spytime)
    (up-chat-data-to-all "c1_enemy: player %d researched Treason to find your king" g: ov-me)
)

; backup: the spy command
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now g:>= ov-spytime)
    (building-type-count ov-castle >= 1)
    (not (can-research ov-ri-spies))
    (can-spy)
=>
    (spy)
    (up-modify-goal ov-spied g:= ov-now)
    (up-modify-goal ov-spytime g:= ov-now)
    (up-modify-goal ov-spytime c:+ ov-spy-every)
    (up-set-shared-goal c: 243 g: ov-spytime)
    (up-chat-data-to-all "c1_enemy: player %d used Treason to find your king" g: ov-me)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-spied c:> 0)
=>
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-spied)
)

; 20s after my Treason: tell you whether anyone on the team saw the king since
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-spied c:> 0)
    (up-compare-goal ov-tmp c:>= ov-spy-check)
    (up-compare-goal ov-ktime g:>= ov-spied)
    (up-compare-const ov-chatty == 1)
=>
    (up-chat-data-to-all "c1_enemy: player %d - Treason worked, your king was seen" g: ov-me)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-spied c:> 0)
    (up-compare-goal ov-tmp c:>= ov-spy-check)
    (up-compare-goal ov-ktime g:< ov-spied)
    (up-compare-const ov-chatty == 1)
=>
    (up-chat-data-to-all "c1_enemy: player %d - Treason did NOT show us your king" g: ov-me)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-spied c:> 0)
    (up-compare-goal ov-tmp c:>= ov-spy-check)
=>
    (up-modify-goal ov-spied c:= 0)
)

; waves: ov-tmp2 = when the next wave is due
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
=>
    (up-get-shared-goal c: 246 ov-tmp2)
)

; wave due and I'm first: pick the team target
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-now g:>= ov-tmp2)
=>
    (up-modify-goal ov-tgt-x c:= -1)
    (up-modify-goal ov-tgt-y c:= -1)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-ktime)
)

; the king's last known position, if he was seen recently
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-now g:>= ov-tmp2)
    (up-compare-goal ov-ktime c:> 0)
    (up-compare-goal ov-tmp c:<= ov-king-memory)
=>
    (up-get-shared-goal c: 240 ov-tgt-x)
    (up-get-shared-goal c: 241 ov-tgt-y)
    (up-chat-data-to-all "c1_enemy: player %d - wave: ALL armies to your king's last known position" g: ov-me)
)

; otherwise your nearest building
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-now g:>= ov-tmp2)
    (up-compare-goal ov-tgt-x c:< 0)
=>
    (up-get-point ov-pos-focus ov-tgt-x)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-now g:>= ov-tmp2)
    (up-compare-goal ov-tgt-x c:< 0)
=>
    (up-get-point ov-pos-target ov-tgt-x)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-now g:>= ov-tmp2)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-tmp c:> ov-king-memory)
=>
    (up-chat-data-to-all "c1_enemy: player %d - wave: ALL armies to your nearest building" g: ov-me)
)

; share it: every AI sends everything on its next tick
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-now g:>= ov-tmp2)
    (up-compare-goal ov-tgt-x c:>= 0)
=>
    (up-set-shared-goal c: 206 g: ov-tgt-x)
    (up-set-shared-goal c: 207 g: ov-tgt-y)
    (up-get-shared-goal c: 245 ov-tmp)
    (up-modify-goal ov-tmp c:+ 1)
    (up-set-shared-goal c: 245 g: ov-tmp)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp c:+ ov-wave-every)
    (up-set-shared-goal c: 246 g: ov-tmp)
)

; every AI: read the team order
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 245 ov-ordid)
    (up-get-shared-goal c: 206 ov-tgt-x)
    (up-get-shared-goal c: 207 ov-tgt-y)
    (up-get-point ov-pos-self ov-home-x)
)

;;; ---------- WAVE: every soldier attack-moves to the team target
; new team order: EVERY soldier I have, wherever it is, attack-moves to the target
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-ordid g:!= ov-myord)
    (up-compare-goal ov-tgt-x c:>= 0)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-ordid g:!= ov-myord)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-ordid g:!= ov-myord)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-ordid g:!= ov-myord)
    (up-compare-goal ov-tgt-x c:>= 0)
=>
    (up-modify-goal ov-myord g:= ov-ordid)
)

; every 30s: idle soldiers out in the field go to the target too (the ones at home wait for the wave)
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-home-x c:>= 0)
=>
    (up-full-reset-search)
    (up-filter-include ov-cmdid-military -1 -1 -1)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-idling == 0)
    (up-set-target-point ov-home-x)
    (up-remove-objects ov-search-local ov-od-distance < ov-home-radius)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-home-x c:>= 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-idling == 0)
    (up-set-target-point ov-home-x)
    (up-remove-objects ov-search-local ov-od-distance < ov-home-radius)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now c:>= ov-truce-max)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-home-x c:>= 0)
    (up-compare-goal ov-ss-last c:>= 240)
=>
    (up-reset-search 0 1 0 0)
    (up-find-local c: ov-all-units c: 240)
    (up-get-search-state ov-ss)
    (up-remove-objects ov-search-local ov-od-class == ov-king-class)
    (up-remove-objects ov-search-local ov-od-class == ov-transport-class)
    (up-remove-objects ov-search-local ov-od-class == ov-fishing-class)
    (up-remove-objects ov-search-local ov-od-class == ov-warship-class)
    (up-remove-objects ov-search-local ov-od-class == ov-unpacked-treb-class)
    (up-remove-objects ov-search-local ov-od-garrisoned == 1)
    (up-remove-objects ov-search-local ov-od-idling == 0)
    (up-set-target-point ov-home-x)
    (up-remove-objects ov-search-local ov-od-distance < ov-home-radius)
    (up-target-point ov-tgt-x ov-act-attack-move ov-attack-formation ov-stance-aggressive)
)

; after the truce: no stock attack groups pulling soldiers elsewhere
(defrule
    (up-compare-goal ov-now c:>= ov-truce-max)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-disable-attack-groups 1)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-disable-defend-groups ov-defend-flags)
    (set-strategic-number sn-number-tasked-units 0)
    (set-strategic-number sn-enable-patrol-attack 1)
)

; plenty of wood: new lumber camps only right next to a town center
(defrule
    (wood-amount >= ov-plenty)
=>
    (set-strategic-number sn-lumber-camp-max-distance ov-camp-dist)
)

(defrule
    (wood-amount < ov-plenty)
=>
    (set-strategic-number sn-lumber-camp-max-distance 0)
)

(defrule
    (gold-amount >= ov-plenty)
    (stone-amount >= ov-plenty)
=>
    (set-strategic-number sn-mining-camp-max-distance ov-camp-dist)
)

(defrule
    (or (gold-amount < ov-plenty) (stone-amount < ov-plenty))
=>
    (set-strategic-number sn-mining-camp-max-distance 0)
)

; at the pop cap, idle trade carts give their population to soldiers
(defrule
    (up-compare-goal ov-tick c:== 1)
    (population-headroom < ov-cart-headroom)
    (up-idle-unit-count ov-idle-trade-cart >= 1)
=>
    (up-delete-idle-units ov-idle-trade-cart)
)

;;; ---------- REPORT: type 200 (all AIs) or 202-208 (one AI) in chat
; resource report for you
(defrule
    (player-number 2)
    (or (taunt-detected ov-target-player ov-report-all) (taunt-detected ov-target-player 202))
=>
    (chat-to-all "c1_enemy: player 2 resources -")
    (up-get-fact food-amount 0 ov-tmp)
    (up-chat-data-to-all "food %d" g: ov-tmp)
    (up-get-fact wood-amount 0 ov-tmp)
    (up-chat-data-to-all "wood %d" g: ov-tmp)
    (up-get-fact gold-amount 0 ov-tmp)
    (up-chat-data-to-all "gold %d" g: ov-tmp)
    (up-get-fact stone-amount 0 ov-tmp)
    (up-chat-data-to-all "stone %d" g: ov-tmp)
    (up-get-fact ov-fact-military-pop 0 ov-tmp)
    (up-chat-data-to-all "soldiers %d" g: ov-tmp)
)

