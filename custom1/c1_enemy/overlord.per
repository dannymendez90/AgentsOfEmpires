;;; overlord.per - generated by custom1/gen_overlord.py; edit that file, not this one.
;;; Team coordination layer for c1_enemy on top of the stock Promisory AI.

(defconst ov-target-player 1)
(defconst ov-tick-secs 5)
(defconst ov-cmd-every 3)
(defconst ov-hb-stale 20)
(defconst ov-min-army 25)
(defconst ov-min-team-army 150)
(defconst ov-ready-pct 60)
(defconst ov-ready-cap 200)
(defconst ov-team-ready-pct 75)
(defconst ov-gather-timeout 240)
(defconst ov-retreat-pct 45)
(defconst ov-attack-timeout 600)
(defconst ov-rally-dist 40)
(defconst ov-near-dist 22)
(defconst ov-arrived-dist 10)
(defconst ov-cart-headroom 15)
(defconst ov-fact-game-time 0)
(defconst ov-fact-pop-headroom 2)
(defconst ov-fact-military-pop 31)
(defconst ov-pos-center 0)
(defconst ov-pos-self 9)
(defconst ov-pos-target 10)
(defconst ov-search-local 1)
(defconst ov-search-remote 2)
(defconst ov-act-move 1)
(defconst ov-act-attack-move 19)
(defconst ov-form-line 2)
(defconst ov-form-box 4)
(defconst ov-stance-aggressive 0)
(defconst ov-actionid-attack 600)
(defconst ov-od-action 5)
(defconst ov-od-px 8)
(defconst ov-od-py 9)
(defconst ov-od-distance 44)
(defconst ov-od-idling 49)
(defconst ov-king-class 959)
(defconst ov-idle-trade-cart 1)
(defconst ov-now 402)
(defconst ov-me 403)
(defconst ov-next-tick 404)
(defconst ov-tick 405)
(defconst ov-slow 406)
(defconst ov-leader 407)
(defconst ov-tmp 408)
(defconst ov-tmp2 409)
(defconst ov-phase 410)
(defconst ov-last-phase 411)
(defconst ov-wave 412)
(defconst ov-army 413)
(defconst ov-needed 414)
(defconst ov-regroup-first 415)
(defconst ov-pulses 416)
(defconst ov-idx 417)
(defconst ov-alive 428)
(defconst ov-ready 429)
(defconst ov-armysum 430)
(defconst ov-armystart 431)
(defconst ov-ss 432)
(defconst ov-ss-last 433)
(defconst ov-ss-remote 434)
(defconst ov-ss-remote-last 435)
(defconst ov-rally-x 436)
(defconst ov-rally-y 437)
(defconst ov-tgt-x 438)
(defconst ov-tgt-y 439)
(defconst ov-home-x 440)
(defconst ov-home-y 441)
(defconst ov-lead-num 442)
(defconst ov-lead-time 443)

; always attack the overlord
(defrule
    (true)
=>
    (set-strategic-number sn-target-player-number ov-target-player)
    (set-strategic-number sn-focus-player-number ov-target-player)
)

(defrule
    (player-number 1)
=>
    (up-modify-goal ov-me c:= 1)
    (disable-self)
)

(defrule
    (player-number 2)
=>
    (up-modify-goal ov-me c:= 2)
    (disable-self)
)

(defrule
    (player-number 3)
=>
    (up-modify-goal ov-me c:= 3)
    (disable-self)
)

(defrule
    (player-number 4)
=>
    (up-modify-goal ov-me c:= 4)
    (disable-self)
)

(defrule
    (player-number 5)
=>
    (up-modify-goal ov-me c:= 5)
    (disable-self)
)

(defrule
    (player-number 6)
=>
    (up-modify-goal ov-me c:= 6)
    (disable-self)
)

(defrule
    (player-number 7)
=>
    (up-modify-goal ov-me c:= 7)
    (disable-self)
)

(defrule
    (player-number 8)
=>
    (up-modify-goal ov-me c:= 8)
    (disable-self)
)

; clock
(defrule
    (true)
=>
    (up-get-fact ov-fact-game-time 0 ov-now)
    (up-modify-goal ov-tick c:= 0)
)

(defrule
    (up-compare-goal ov-now g:>= ov-next-tick)
=>
    (up-modify-goal ov-tick c:= 1)
    (up-modify-goal ov-next-tick g:= ov-now)
    (up-modify-goal ov-next-tick c:+ ov-tick-secs)
    (up-modify-goal ov-slow c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:>= ov-cmd-every)
=>
    (up-modify-goal ov-slow c:= 0)
)

(defrule
    (up-compare-goal ov-me c:>= 1)
    (up-compare-goal ov-now c:>= 3)
=>
    (up-chat-data-to-all "c1_enemy: player %d joined the coalition" g: ov-me)
    (disable-self)
)

; heartbeat and army size for the leader
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-fact ov-fact-military-pop 0 ov-army)
    (up-modify-goal ov-idx c:= 210)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx g: ov-now)
    (up-modify-goal ov-idx c:= 230)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx g: ov-army)
)

; leader election: first AI to find no living leader takes over
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 200 ov-lead-num)
    (up-get-shared-goal c: 201 ov-lead-time)
    (up-modify-goal ov-leader c:= 0)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-lead-time)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-lead-num g:== ov-me)
=>
    (up-modify-goal ov-leader c:= 1)
    (up-set-shared-goal c: 201 g: ov-now)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 0)
    (or (up-compare-goal ov-lead-num c:== 0) (up-compare-goal ov-tmp c:> ov-hb-stale))
=>
    (up-set-shared-goal c: 200 g: ov-me)
    (up-set-shared-goal c: 201 g: ov-now)
    (up-modify-goal ov-leader c:= 1)
)

; leader: count living, ready and total army across the team
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-modify-goal ov-alive c:= 0)
    (up-modify-goal ov-ready c:= 0)
    (up-modify-goal ov-armysum c:= 0)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 211 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 231 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 221 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 212 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 232 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 222 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 213 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 233 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 223 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 214 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 234 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 224 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 215 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 235 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 225 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 216 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 236 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 226 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 217 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 237 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 227 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 218 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
=>
    (up-modify-goal ov-tmp c:= 9999)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
=>
    (up-modify-goal ov-alive c:+ 1)
    (up-get-shared-goal c: 238 ov-tmp2)
    (up-modify-goal ov-armysum g:+ ov-tmp2)
    (up-get-shared-goal c: 228 ov-tmp2)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:<= ov-hb-stale)
    (up-compare-goal ov-tmp2 c:== 1)
=>
    (up-modify-goal ov-ready c:+ 1)
)

; leader: base the plan on your nearest building
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 202 ov-phase)
    (up-get-point ov-pos-self ov-home-x)
    (up-get-point ov-pos-target ov-tgt-x)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-home-x c:< 0)
=>
    (up-get-point ov-pos-center ov-home-x)
)

; rally point sits ov-rally-dist tiles in front of that building, toward the leader's base
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:<= 1)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-tgt-y c:>= 0)
=>
    (up-modify-goal ov-rally-x g:= ov-tgt-x)
    (up-modify-goal ov-rally-y g:= ov-tgt-y)
    (up-lerp-tiles ov-rally-x ov-home-x c: ov-rally-dist)
    (up-bound-point ov-rally-x ov-rally-x)
    (up-set-shared-goal c: 204 g: ov-rally-x)
    (up-set-shared-goal c: 205 g: ov-rally-y)
)

; leader: if your king is visible, he becomes the attack target
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-full-reset-search)
    (up-find-remote c: ov-king-class c: 1)
    (up-get-search-state ov-ss)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-ss-remote c:>= 1)
=>
    (up-set-target-object ov-search-remote c: 0)
    (up-get-object-data ov-od-px ov-tgt-x)
    (up-get-object-data ov-od-py ov-tgt-y)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tgt-x c:>= 0)
    (up-compare-goal ov-tgt-y c:>= 0)
=>
    (up-set-shared-goal c: 206 g: ov-tgt-x)
    (up-set-shared-goal c: 207 g: ov-tgt-y)
)

; leader: start the first gather
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 0)
=>
    (up-set-shared-goal c: 202 c: 1)
    (up-set-shared-goal c: 208 g: ov-now)
    (up-modify-goal ov-phase c:= 1)
    (chat-to-all "c1_enemy coalition: gathering armies")
)

; leader: ov-tmp = seconds in phase, ov-tmp2 = ready x 100, ov-needed = alive x pct
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 208 ov-tmp2)
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-tmp2)
    (up-modify-goal ov-tmp2 g:= ov-ready)
    (up-modify-goal ov-tmp2 c:* 100)
    (up-modify-goal ov-needed g:= ov-alive)
    (up-modify-goal ov-needed c:* ov-team-ready-pct)
)

; leader: gather -> attack when most armies are ready, or the gather timer runs out
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-armysum c:>= ov-min-team-army)
    (up-compare-goal ov-ready c:>= 1)
    (or (up-compare-goal ov-tmp2 g:>= ov-needed) (up-compare-goal ov-tmp c:>= ov-gather-timeout))
=>
    (up-set-shared-goal c: 202 c: 2)
    (up-set-shared-goal c: 208 g: ov-now)
    (up-set-shared-goal c: 209 g: ov-armysum)
    (up-get-shared-goal c: 203 ov-wave)
    (up-modify-goal ov-wave c:+ 1)
    (up-set-shared-goal c: 203 g: ov-wave)
    (up-modify-goal ov-phase c:= 2)
    (up-modify-goal ov-tmp c:= 0)
    (up-chat-data-to-all "c1_enemy coalition: ATTACK! wave %d" g: ov-wave)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
=>
    (up-get-shared-goal c: 209 ov-armystart)
    (up-modify-goal ov-tmp2 g:= ov-armysum)
    (up-modify-goal ov-tmp2 c:* 100)
    (up-modify-goal ov-needed g:= ov-armystart)
    (up-modify-goal ov-needed c:* ov-retreat-pct)
)

; leader: attack -> regroup after heavy losses or a long fight
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-phase c:== 2)
    (or (up-compare-goal ov-tmp2 g:< ov-needed) (up-compare-goal ov-tmp c:>= ov-attack-timeout))
=>
    (up-set-shared-goal c: 202 c: 1)
    (up-set-shared-goal c: 208 g: ov-now)
    (up-modify-goal ov-phase c:= 1)
    (up-chat-data-to-all "c1_enemy coalition: regrouping, %d soldiers left" g: ov-armysum)
)

; every AI: read the shared plan
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 202 ov-phase)
    (up-get-shared-goal c: 204 ov-rally-x)
    (up-get-shared-goal c: 205 ov-rally-y)
    (up-get-shared-goal c: 206 ov-tgt-x)
    (up-get-shared-goal c: 207 ov-tgt-y)
)

; phase changed: reset my ready flag and pulse count
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase g:!= ov-last-phase)
=>
    (up-modify-goal ov-pulses c:= 0)
    (up-modify-goal ov-regroup-first c:= 0)
    (up-modify-goal ov-idx c:= 220)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx c: 0)
)

; coming back from an attack: pull everyone out once
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-last-phase c:== 2)
=>
    (up-modify-goal ov-regroup-first c:= 1)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-modify-goal ov-last-phase g:= ov-phase)
)

; at the pop cap, idle trade carts give their population to soldiers
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:== 0)
    (population-headroom < ov-cart-headroom)
    (up-idle-unit-count ov-idle-trade-cart >= 1)
=>
    (up-delete-idle-units ov-idle-trade-cart)
)

;;; ---------- GATHER: march to the rally point
; count my soldiers at the rally point
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
=>
    (up-full-reset-search)
    (up-set-target-point ov-rally-x)
    (up-find-local c: 906 c: 240)
    (up-find-local c: 912 c: 240)
    (up-find-local c: 900 c: 240)
    (up-find-local c: 936 c: 240)
    (up-find-local c: 913 c: 240)
    (up-find-local c: 944 c: 240)
    (up-find-local c: 923 c: 240)
    (up-find-local c: 955 c: 240)
    (up-find-local c: 951 c: 240)
    (up-find-local c: 935 c: 240)
    (up-remove-objects ov-search-local ov-od-distance > ov-near-dist)
    (up-get-search-state ov-ss)
    (up-modify-goal ov-needed g:= ov-army)
    (up-modify-goal ov-needed c:* ov-ready-pct)
    (up-modify-goal ov-needed c:/ 100)
    (up-modify-goal ov-needed c:min ov-ready-cap)
)

; enough of my army is assembled: report ready
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-army c:>= ov-min-army)
    (up-compare-goal ov-ss g:>= ov-needed)
    (up-compare-goal ov-pulses c:>= 2)
=>
    (up-modify-goal ov-idx c:= 220)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx c: 1)
)

