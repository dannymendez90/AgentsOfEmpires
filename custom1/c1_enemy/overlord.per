=>
    (chat-to-all "c1_enemy: player 8 joined the coalition")
    (disable-self)
)

; heartbeat and army size for the leader
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-fact ov-fact-military-pop 0 ov-army)
    (up-modify-goal ov-idx c:= 210)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx g: ov-now)
    (up-modify-goal ov-idx c:= 230)
    (up-modify-goal ov-idx g:+ ov-me)
    (up-set-shared-goal g: ov-idx g: ov-army)
)

; every AI: report your king whenever it can see him
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-find-remote c: ov-king-class c: 1)
    (up-get-search-state ov-ss)
)

(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
=>
    (up-modify-goal ov-tmp g:= ov-now)
    (up-modify-goal ov-tmp g:- ov-ktime)
)

; leader: announce a fresh sighting so you can tell Treason worked
(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
    (up-compare-goal ov-leader c:== 1)
    (up-compare-goal ov-tmp c:> ov-king-stale)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy coalition: king spotted, attacking his position")
)

(defrule
    (up-compare-goal ov-ss-remote c:>= 1)
=>
    (up-modify-goal ov-ktime g:= ov-now)
    (up-set-target-object ov-search-remote c: 0)
    (up-get-object-data ov-od-px ov-tmp)
    (up-get-object-data ov-od-py ov-tmp2)
    (up-set-shared-goal c: 240 g: ov-tmp)
    (up-set-shared-goal c: 241 g: ov-tmp2)
    (up-set-shared-goal c: 242 g: ov-now)
)

; Treason: one shared clock for the team (SPYNEXT = game time the next one is due)
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 242 ov-ktime)
    (up-get-shared-goal c: 243 ov-spytime)
)

; the first Treason is due ov-spy-lead seconds before the truce ends
(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-modify-goal ov-spytime c:max ov-first-spy)
)

; Treason due and I have a castle: make sure the gold is there (the queen's pad can drain it)
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now g:>= ov-spytime)
    (building-type-count ov-castle >= 1)
    (gold-amount < ov-spy-gold)
=>
    (cc-add-resource gold ov-spy-gold)
)

; Treason = castle tech 408 (this is what worked in v2). The shared clock stops every other AI until the next one is due
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now g:>= ov-spytime)
    (building-type-count ov-castle >= 1)
    (player-number 2)
    (can-research ov-ri-spies)
=>
    (research ov-ri-spies)
    (up-modify-goal ov-spytime g:= ov-now)
    (up-modify-goal ov-spytime c:+ ov-spy-every)
    (up-set-shared-goal c: 243 g: ov-spytime)
    (chat-to-all "c1_enemy: player 2 researched Treason to find your king")
)

; backup: the spy command, if the tech can't be researched right now
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-now g:>= ov-spytime)
    (building-type-count ov-castle >= 1)
    (player-number 2)
    (not (can-research ov-ri-spies))
    (can-spy)
=>
    (spy)
    (up-modify-goal ov-spytime g:= ov-now)
    (up-modify-goal ov-spytime c:+ ov-spy-every)
    (up-set-shared-goal c: 243 g: ov-spytime)
    (chat-to-all "c1_enemy: player 2 used Treason to find your king")
)

