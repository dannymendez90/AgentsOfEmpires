    (up-compare-goal ov-slow c:== 0)
    (up-compare-goal ov-phase c:== 1)
    (up-compare-goal ov-rally-x c:> 0)
    (up-compare-goal ov-regroup-first c:== 1)
=>
    (up-full-reset-search)
    (up-set-target-point ov-rally-x)
    (up-find-local c: 906 c: 240)
    (up-get-search-state ov-ss)
    (up-target-point 0 ov-act-move ov-form-line ov-stance-aggressive)
)

