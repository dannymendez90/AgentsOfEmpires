;;; overlord.per - generated by custom1/gen_overlord.py; edit that file, not this one.
;;; Team coordination layer for c1_enemy on top of the stock Promisory AI.

(defconst ov-target-player 1)
(defconst ov-tick-secs 5)
(defconst ov-cmd-every 3)
(defconst ov-hb-stale 20)
(defconst ov-min-army 25)
(defconst ov-min-team-army 150)
(defconst ov-ready-pct 60)
(defconst ov-ready-cap 200)
(defconst ov-team-ready-pct 75)
(defconst ov-gather-timeout 180)
(defconst ov-retreat-pct 40)
