(defconst ov-retarget-dist 12)
(defconst ov-reinforce-every 6)
(defconst ov-attack-formation 2)
(defconst ov-march-formation -1)
(defconst ov-stage-secs 240)
(defconst ov-king-memory 180)
(defconst ov-king-stale 90)
(defconst ov-spy-every 600)
(defconst ov-defend-flags 14)
(defconst ov-cart-headroom 15)
