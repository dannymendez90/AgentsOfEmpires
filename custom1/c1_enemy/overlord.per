; always attack the overlord
(defrule
    (true)
=>
    (set-strategic-number sn-target-player-number ov-target-player)
    (set-strategic-number sn-focus-player-number ov-target-player)
)

(defrule
    (player-number 1)
=>
    (up-modify-goal ov-me c:= 1)
    (disable-self)
)

(defrule
    (player-number 2)
=>
    (up-modify-goal ov-me c:= 2)
    (disable-self)
)

(defrule
    (player-number 3)
=>
    (up-modify-goal ov-me c:= 3)
    (disable-self)
)

(defrule
    (player-number 4)
=>
    (up-modify-goal ov-me c:= 4)
    (disable-self)
)

(defrule
    (player-number 5)
=>
    (up-modify-goal ov-me c:= 5)
    (disable-self)
)

(defrule
    (player-number 6)
=>
    (up-modify-goal ov-me c:= 6)
    (disable-self)
)

(defrule
    (player-number 7)
=>
    (up-modify-goal ov-me c:= 7)
    (disable-self)
)

(defrule
    (player-number 8)
=>
    (up-modify-goal ov-me c:= 8)
    (disable-self)
)

; clock
(defrule
    (true)
=>
    (up-get-fact ov-fact-game-time 0 ov-now)
    (up-modify-goal ov-tick c:= 0)
)

(defrule
    (up-compare-goal ov-now g:>= ov-next-tick)
=>
    (up-modify-goal ov-tick c:= 1)
    (up-modify-goal ov-next-tick g:= ov-now)
    (up-modify-goal ov-next-tick c:+ ov-tick-secs)
    (up-modify-goal ov-slow c:+ 1)
    (up-get-treaty-data ov-treaty)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-slow c:>= ov-cmd-every)
=>
    (up-modify-goal ov-slow c:= 0)
)

; truce: a reading in milliseconds becomes seconds
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-treaty c:> 36000)
=>
    (up-modify-goal ov-treaty c:/ 1000)
)

(defrule
    (up-compare-goal ov-tick c:== 1)
=>
    (up-get-shared-goal c: 244 ov-tmp2)
)

; truce: remember when it should end, from the first reading
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-tmp2 c:<= 0)
    (up-compare-goal ov-now c:>= 2)
=>
    (up-modify-goal ov-tmp2 g:= ov-treaty)
    (up-modify-goal ov-tmp2 g:+ ov-now)
    (up-modify-goal ov-tmp2 c:+ 1)
    (up-set-shared-goal c: 244 g: ov-tmp2)
)

; truce: ov-treaty = seconds left
(defrule
    (up-compare-goal ov-tick c:== 1)
    (up-compare-goal ov-tmp2 c:> 0)
=>
    (up-modify-goal ov-tmp g:= ov-tmp2)
    (up-modify-goal ov-tmp g:- ov-now)
    (up-modify-goal ov-treaty g:min ov-tmp)
    (up-modify-goal ov-tmp c:= ov-truce-max)
    (up-modify-goal ov-tmp g:- ov-now)
    (up-modify-goal ov-treaty g:min ov-tmp)
    (up-modify-goal ov-treaty c:max 0)
)

; proof the coalition layer is running
(defrule
    (player-number 2)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 2 joined the coalition")
    (disable-self)
)

(defrule
    (player-number 3)
    (up-compare-goal ov-now c:>= 3)
    (up-compare-const ov-chatty == 1)
=>
    (chat-to-all "c1_enemy: player 3 joined the coalition")
    (disable-self)
)

(defrule
    (player-number 4)
    (up-compare-goal ov-now c:>= 3)
